---
// Use case: one board for the work of several teams and projects. Every key, name and note in
// the drawings is made up.
import type { Item } from '../../data/board'
import { brand, DEMO, DOCS } from '../../data/site'
import Cta from '../../components/Cta.astro'
import Clip from '../../components/Clip.astro'
import Faq from '../../components/Faq.astro'
import FeatureFrame from '../../components/FeatureFrame.astro'
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header.astro'
import Icon from '../../components/Icon.astro'
import Install from '../../components/Install.astro'
import MiniBoard from '../../components/MiniBoard.astro'
import SelfHost from '../../components/SelfHost.astro'
import Trackers from '../../components/Trackers.astro'
import Base from '../../layouts/Base.astro'


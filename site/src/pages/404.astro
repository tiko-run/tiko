---
import Brand from '../components/Brand.astro'
import { DOCS } from '../data/site'
import Base from '../layouts/Base.astro'
---

<Base title="Page not found · tiko" index={false}>
  <main id="main" class="dots">
    <Brand mark="emblem" height={48} />
    <h1>This page is not on the board</h1>
    <p>The address may have changed, or it never existed.</p>
    <div>
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-outline" href={`${DOCS}/`}>Open the guide</a>
    </div>
  </main>
</Base>

<style>
  main {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
    min-height: 100vh;
    padding: 2rem;
    text-align: center;
  }
  h1 {
    margin-top: 0.5rem;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  p {
    color: var(--muted-foreground);
  }
  div {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
</style>

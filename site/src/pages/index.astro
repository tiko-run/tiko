---
import Cta from '../components/Cta.astro'
import Faq from '../components/Faq.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import OpenSource from '../components/OpenSource.astro'
import FeatureFrames from '../components/FeatureFrames.astro'
import Hero from '../components/Hero.astro'
import LiveCards from '../components/LiveCards.astro'
import Scenarios from '../components/Scenarios.astro'
import SelfHost from '../components/SelfHost.astro'
import Trackers from '../components/Trackers.astro'
import Base from '../layouts/Base.astro'
---

<Base>
  <Header />
  <main id="main" class="dots canvas">
    <Hero />
    <LiveCards />
    <Trackers />
    <FeatureFrames />
    <Scenarios />
    <SelfHost />
    <OpenSource />
    <Faq />
    <Cta />
  </main>
  <Footer />
</Base>

<style>
  .canvas {
    background-attachment: local;
  }
</style>

<script>
  import '../scripts/page'
  import '../scripts/install'
  import '../scripts/waitlist'
</script>

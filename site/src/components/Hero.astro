---
// The hero: the headline is made of canvas objects, and the board pins while the camera
// pulls back to show it is one frame on a larger canvas. Without scroll timelines it is the
// plain hero.
import { DEMO, TRACKERS } from '../data/site'
import BoardSim from './BoardSim.astro'
import Icon from './Icon.astro'
import Install from './Install.astro'
import Logo from './Logo.astro'
import Waitlist from './Waitlist.astro'

const facts = ['Open source, AGPL-3.0', 'Self-hosted', 'Your tracker stays the source of truth', 'No ads, no analytics trackers']
---

<section class="hero">
  <div class="wrap copy">
    <Waitlist source="hero" />
    <h1>
      A <span class="w-select">whiteboard<i class="h tl"></i><i class="h tr"></i><i class="h bl"></i><i class="h br"></i></span>
      where your <span class="w-card" data-word><span class="w-type"><Icon name="check" size={12} /></span>tasks</span>
      stay <span class="w-live">live<i></i></span>
    </h1>
    <p class="sub">
      <b class="tiko">tiko</b> puts the tasks from
      <span class="rot" data-rot>
        <span class="sr-only">your tracker</span>
        <span class="rot-box" aria-hidden="true">
          {
            TRACKERS.map((t, i) => (
              <span class:list={['ri', { on: i === 0 }]}>
                <Logo id={t.id} size={20} />
                {t.name}
                {!t.live && <small>soon</small>}
              </span>
            ))
          }
        </span>
      </span>
      on an infinite canvas as cards. Arrange them the way you think. Their statuses update on
      their own.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href={DEMO}>Try the demo <Icon name="arrow-right" /></a>
      <Install />
    </div>
    <ul class="facts">
      {facts.map((fact) => <li><Icon name="check" size={14} />{fact}</li>)}
    </ul>
  </div>

  <div class="track">
    <div class="pin">
      <div class="wrap">
        <div class="world">
          <BoardSim />

          <div class="sat s-ideas" aria-hidden="true">
            <span class="sat-title">Ideas</span>
            <i class="st pink">Split the billing cron</i>
            <i class="st violet">Ask QA before Friday</i>
            <i class="st green">Demo to sales</i>
          </div>

          <div class="sat s-plan" aria-hidden="true">
            <span class="sat-title">Q4 plan</span>
            <div class="gm">
              <i class="progress" style="--l:4%;--w:42%"></i>
              <i class="done" style="--l:22%;--w:30%"></i>
              <i style="--l:50%;--w:40%"></i>
              <i class="progress" style="--l:68%;--w:28%"></i>
            </div>
          </div>

          <div class="sat s-gh" aria-hidden="true">
            <span class="sat-title">Other teams</span>
            <span class="fc"><Logo id="github" size={22} /><span class="ty"><Icon name="bookmark" size={22} /></span><b>web#14</b>Dark theme for docs<span class="lz progress">In review</span></span>
            <span class="fc"><Logo id="linear" size={22} /><span class="ty"><Icon name="bug" size={22} /></span><b>MOB-19</b>Crash on login<span class="lz done">Done</span></span>
            <span class="fc"><Logo id="gitlab" size={22} /><span class="ty"><Icon name="square-check" size={22} /></span><b>ops!7</b>Rotate the certs<span class="lz">To do</span></span>
          </div>

          <i class="sat st yellow s-note" aria-hidden="true">
            One board per release. Archive after.
            <span class="s-timer"><Icon name="alarm-clock" size={18} /></span>
          </i>

          <span class="sat ptr s-max" aria-hidden="true">
            <svg viewBox="0 0 16 16"><path d="M2 1.5 13.5 7 8.4 8.6 6.6 13.8Z"></path></svg><b>Max</b>
          </span>

          <svg class="sat wire" viewBox="0 0 200 200" preserveAspectRatio="none" aria-hidden="true">
            <path d="M10 20 C 90 20, 110 180, 190 180" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // The tracker name in the subtitle rolls up to the next one every few seconds.
  const box = document.querySelector<HTMLElement>('[data-rot] .rot-box')
  if (box && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = [...box.children] as HTMLElement[]
    let at = 0
    setInterval(() => {
      if (document.hidden) return
      const current = items[at]
      // Names that rolled out earlier go back below, out of sight, ready to roll in.
      for (const item of items) if (item !== current) item.classList.remove('off')
      current.classList.replace('on', 'off')
      at = (at + 1) % items.length
      items[at].classList.add('on')
    }, 2200)
  }

  // The task word in the headline drags like a card and springs back.
  const word = document.querySelector<HTMLElement>('[data-word]')
  word?.addEventListener('pointerdown', (down) => {
    word.setPointerCapture(down.pointerId)
    word.classList.add('held')
    const move = (e: PointerEvent) =>
      word.style.setProperty('translate', `${e.clientX - down.clientX}px ${e.clientY - down.clientY}px`)
    const up = () => {
      word.classList.remove('held')
      word.style.removeProperty('translate')
      word.removeEventListener('pointermove', move)
      word.removeEventListener('pointerup', up)
    }
    word.addEventListener('pointermove', move)
    word.addEventListener('pointerup', up)
  })
</script>

<style>
  .hero {
    position: relative;
    padding-top: clamp(2rem, 4.5vw, 3.5rem);
    overflow-x: clip;
  }
  /* The page grid fades out behind the headline, so the text sits on a calm field. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 46rem;
    background: radial-gradient(ellipse 60% 60% at 50% 30%, var(--background) 45%, transparent 100%);
    pointer-events: none;
  }
  .copy {
    position: relative;
    display: grid;
    justify-items: center;
    margin-bottom: clamp(2rem, 4vw, 2.75rem);
    text-align: center;
  }
  h1 {
    max-width: 18ch;
    font-size: clamp(2.25rem, 5.6vw, 3.75rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  /* "whiteboard" is selected, as on the canvas. */
  .w-select {
    position: relative;
    margin-inline: 0.06em 0.14em;
    padding-inline: 0.08em;
    outline: 2px solid var(--primary);
    outline-offset: 0.04em;
    border-radius: 2px;
  }
  .h {
    position: absolute;
    width: 9px;
    height: 9px;
    border: 2px solid var(--primary);
    border-radius: 2px;
    background: var(--card);
  }
  .tl {
    left: -6px;
    top: -6px;
  }
  .tr {
    right: -6px;
    top: -6px;
  }
  .bl {
    left: -6px;
    bottom: -6px;
  }
  .br {
    right: -6px;
    bottom: -6px;
  }

  /* "tasks" is a task card you can pick up. */
  .w-card {
    display: inline-flex;
    align-items: center;
    gap: 0.18em;
    padding: 0 0.22em 0.04em 0.14em;
    border: 1px solid var(--border);
    border-radius: 0.14em;
    background: var(--card);
    box-shadow: var(--shadow);
    cursor: grab;
    touch-action: none;
    rotate: -2deg;
    transition:
      translate 0.5s cubic-bezier(0.3, 1.6, 0.4, 1),
      rotate 0.2s;
  }
  .w-card.held {
    rotate: 2deg;
    cursor: grabbing;
    transition: rotate 0.2s;
  }
  .w-type {
    display: grid;
    place-items: center;
    width: 0.42em;
    height: 0.42em;
    border-radius: 0.07em;
    background: var(--type-task);
    color: white;
  }
  .w-type :global(svg) {
    width: 0.3em;
    height: 0.3em;
    stroke-width: 3.5;
  }

  /* "live" carries the sync dot. */
  .w-live {
    position: relative;
  }
  .w-live i {
    position: absolute;
    right: -0.24em;
    top: 0.2em;
    width: 0.17em;
    height: 0.17em;
    border-radius: 50%;
    background: var(--sync-ok);
    animation: hero-live 1.8s ease-out infinite;
  }
  @keyframes hero-live {
    from {
      box-shadow: 0 0 0 0 color-mix(in oklch, var(--sync-ok) 55%, transparent);
    }
    70%,
    to {
      box-shadow: 0 0 0 0.22em transparent;
    }
  }

  /* The tracker name rolls through the list. All names share one grid cell, so the slot is
     as wide as the longest one and the text around it never moves. */
  .rot {
    display: inline-block;
    margin-inline: 0.1em;
    vertical-align: bottom;
  }
  /* On a narrow screen the name gets its own line, so its length never rewraps the rest. */
  @media (max-width: 640px) {
    .rot {
      display: block;
    }
  }
  .rot-box {
    display: inline-grid;
    justify-items: center;
    height: 1.55em;
    overflow: hidden;
    vertical-align: bottom;
  }
  .ri {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    height: 1.55em;
    padding-inline: 0.1em;
    color: var(--foreground);
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    translate: 0 100%;
    transition:
      translate 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.3s;
  }
  .ri.on {
    opacity: 1;
    translate: 0 0;
  }
  .ri.off {
    translate: 0 -100%;
  }
  .ri small {
    padding: 0 0.35em;
    border-radius: 4px;
    background: var(--muted);
    color: var(--muted-foreground);
    font-size: 0.62em;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .sub {
    max-width: 44rem;
    margin-top: 1.25rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: var(--muted-foreground);
    text-wrap: balance;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.375rem 1.25rem;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
  .facts li {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .facts :global(svg) {
    color: var(--sync-ok);
  }

  .track {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .world {
    position: relative;
  }

  /* What lies around the board: hidden until the camera pulls back. */
  .sat {
    position: absolute;
    display: none;
  }
  .sat-title {
    position: absolute;
    left: 2px;
    bottom: calc(100% + 8px);
    font-size: 26px;
    font-weight: 500;
    color: var(--muted-foreground);
  }
  /* Satellites are drawn at twice the board's scale: the camera halves them. */
  .st {
    display: block;
    padding: 24px;
    border-radius: 10px;
    color: var(--sticky-foreground);
    font-size: 28px;
    font-style: normal;
    line-height: 1.35;
  }
  .pink {
    background: var(--sticky-pink);
  }
  .violet {
    background: var(--sticky-violet);
  }
  .green {
    background: var(--sticky-green);
  }
  .yellow {
    background: var(--sticky-yellow);
  }
  .s-ideas {
    left: -52%;
    top: 4%;
    width: 44%;
    height: 78%;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: color-mix(in oklab, var(--muted) 40%, var(--background));
  }
  .s-ideas .st {
    position: absolute;
    width: 40%;
    aspect-ratio: 1.4;
  }
  .s-ideas .st:nth-of-type(1) {
    left: 6%;
    top: 8%;
  }
  .s-ideas .st:nth-of-type(2) {
    left: 54%;
    top: 14%;
  }
  .s-ideas .st:nth-of-type(3) {
    left: 30%;
    top: 58%;
  }

  .s-plan {
    right: -52%;
    top: 10%;
    width: 44%;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
    box-shadow: var(--shadow);
  }
  .gm {
    display: grid;
    gap: 14px;
  }
  .gm i {
    display: block;
    height: 28px;
    margin-left: var(--l);
    width: var(--w);
    border-radius: 5px;
    background: var(--todo);
  }
  .gm i.progress {
    background: var(--progress);
  }
  .gm i.done {
    background: var(--done);
  }

  .s-gh {
    right: -46%;
    top: 74%;
    display: none;
    width: 40%;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: color-mix(in oklab, var(--sticky-green) var(--frame-tint), var(--background));
  }
  .fc {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-block: 6px;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
    font-size: 19px;
    white-space: nowrap;
  }
  .fc b {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 17px;
    color: var(--primary);
  }
  .ty {
    display: grid;
    color: var(--muted-foreground);
  }
  .lz {
    margin-left: auto;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--todo);
    color: var(--todo-fg);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .lz.progress {
    background: var(--progress);
    color: var(--progress-fg);
  }
  .lz.done {
    background: var(--done);
    color: var(--done-fg);
  }

  .s-note {
    left: -30%;
    top: 84%;
    width: 22%;
    aspect-ratio: 1.3;
  }
  /* A timer sits on its note's corner, as in the app. */
  .s-timer {
    position: absolute;
    right: -22px;
    top: -22px;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: var(--timer);
    color: var(--timer-foreground);
  }
  .s-timer :global(svg) {
    width: 26px;
    height: 26px;
  }
  .ptr {
    align-items: flex-start;
    gap: 2px;
  }
  .ptr svg {
    width: 28px;
    height: 28px;
    fill: oklch(0.62 0.16 160);
    stroke: var(--card);
  }
  .ptr b {
    margin-top: 20px;
    padding: 2px 10px;
    border-radius: 6px;
    background: oklch(0.62 0.16 160);
    color: white;
    font-size: 17px;
    font-weight: 500;
  }
  .s-max {
    right: -14%;
    top: 46%;
  }
  .wire {
    left: 100%;
    top: 40%;
    width: 8%;
    height: 40%;
    fill: none;
    stroke: var(--muted-foreground);
    stroke-width: 2.5;
    stroke-dasharray: 8 6;
    vector-effect: non-scaling-stroke;
    opacity: 0.6;
  }

  /* The camera pulls back while the board is pinned. Wide screens with scroll timelines only. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 960px) {
      .track {
        height: 210vh;
        padding-bottom: 0;
        view-timeline: --zoom block;
      }
      .pin {
        position: sticky;
        top: 4.5rem;
      }
      .world {
        transform-origin: 50% 0;
        animation-name: hero-pull-back;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --zoom;
        animation-range: contain 0% contain 70%;
      }
      .sat {
        display: block;
        opacity: 0;
        animation-name: hero-appear;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --zoom;
        animation-range: contain 20% contain 65%;
      }
      .ptr {
        display: flex;
      }
      .s-gh {
        display: block;
      }
    }
  }
  @keyframes hero-pull-back {
    to {
      transform: scale(0.5) translateY(36%);
    }
  }
  @keyframes hero-appear {
    to {
      opacity: 1;
    }
  }
</style>

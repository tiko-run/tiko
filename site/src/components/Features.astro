---
// Six things tiko does, each with a small looping drawing in the board's own look. A real
// screencast can replace any drawing later: the tile only needs a 320×200 picture.
import { DOCS } from '../data/site'
import Icon from './Icon.astro'
---

<section class="section" id="features">
  <div class="wrap">
    <h2 class="h2 reveal">Your tracker keeps the tasks. <b class="tiko">tiko</b> gives them a place.</h2>
    <p class="lead reveal">
      Lists and columns hide how work fits together. On a canvas you group it, plan it and see
      what is waiting on what, with statuses that are never out of date.
    </p>

    <div class="grid">
      <article class="tile reveal">
        <div class="visual dots" aria-hidden="true">
          <div class="art live">
            <span class="chip"><i></i>Synced just now</span>
            <div class="fc" style="--y:44px">
              <span class="ty"><Icon name="bookmark" size={14} /></span><span class="k">APP-112</span>Retry payments<span class="lz progress">In progress</span>
            </div>
            <div class="fc turning" style="--y:88px">
              <span class="ty"><Icon name="square-check" size={14} /></span><span class="k">APP-118</span>Billing cron
              <span class="swap"><span class="lz progress">In review</span><span class="lz done">Done</span></span>
            </div>
            <div class="fc" style="--y:132px">
              <span class="ty"><Icon name="bug" size={14} /></span><span class="k">APP-127</span>Flaky login test<span class="lz">To do</span>
            </div>
          </div>
        </div>
        <div class="body">
          <h3>Cards that stay live</h3>
          <p>Add tasks by key, link or query. Each card shows the real status from your tracker, refreshed every 30 seconds.</p>
          <a class="more" href={`${DOCS}/adding-tasks/`}>Adding tasks <Icon name="arrow-right" /></a>
        </div>
      </article>

      <article class="tile reveal" style="--d:0.08s">
        <div class="visual dots" aria-hidden="true">
          <div class="art arrange">
            <div class="fr"><b>Ideas</b></div>
            <i class="st yellow">Split the cron</i>
            <i class="st blue">Ask QA first</i>
            <span class="guide"></span>
          </div>
        </div>
        <div class="body">
          <h3>Arrange them the way you think</h3>
          <p>Frames, sticky notes, text and arrows around the cards, with smart guides that snap things into place.</p>
          <a class="more" href={`${DOCS}/adding-tasks/#around-the-cards`}>The board <Icon name="arrow-right" /></a>
        </div>
      </article>

      <article class="tile reveal" style="--d:0.16s">
        <div class="visual dots" aria-hidden="true">
          <div class="art plan">
            <div class="gm">
              <div class="gm-head">Oct<span>5–11</span><span>12–18</span><span>19–25</span><span>26–1</span></div>
              <div class="gm-row"><i class="progress" style="--l:2%;--w:58%"><Icon name="bookmark" size={14} /><span>APP-112 Retry payments</span></i></div>
              <div class="gm-row"><i class="done" style="--l:28%;--w:52%;--t:0.25s"><Icon name="square-check" size={14} /><span>APP-118 Billing cron</span></i></div>
              <div class="gm-row"><i style="--l:60%;--w:39%;--t:0.5s"><Icon name="square-check" size={14} /><span>APP-121 Notes</span></i></div>
              <span class="gm-today"></span>
              <span class="gm-stone"></span>
            </div>
          </div>
        </div>
        <div class="body">
          <h3>Plan on a timeline</h3>
          <p>Drop cards onto a Gantt and get bars with live status, milestones and dependency lines. Planning mode adds stages, people and their workload.</p>
          <a class="more" href={`${DOCS}/gantt/`}>Gantt <Icon name="arrow-right" /></a>
        </div>
      </article>

      <article class="tile reveal">
        <div class="visual dots" aria-hidden="true">
          <div class="art wait">
            <span class="cube"><span class="run"><Icon name="alarm-clock" size={14} />2m</span><span class="fired"><Icon name="bell-ring" size={14} /></span></span>
            <div class="fc" style="--x:74px;--y:52px">
              <span class="ty"><Icon name="square-check" size={14} /></span><span class="k">APP-118</span>Billing cron<span class="lz progress">In review</span>
            </div>
            <div class="went">
              <span class="went-cube"><Icon name="bell-ring" size={14} /></span>
              <span><b>Ping QA about the cron</b><small>On APP-118 · Went off at 15:30</small></span>
              <span class="went-act"><i class="primary">Done</i><i>+10 min</i><i>+1 hour</i></span>
            </div>
          </div>
        </div>
        <div class="body">
          <h3>Wait without watching</h3>
          <p>Put a timer next to a card. It goes off after a set time or when the task leaves its status.</p>
          <a class="more" href={`${DOCS}/focus-and-timers/`}>Timers and focus <Icon name="arrow-right" /></a>
        </div>
      </article>

      <article class="tile reveal" style="--d:0.08s">
        <div class="visual dots" aria-hidden="true">
          <div class="art find">
            <div class="pal">
              <div class="pal-in"><Icon name="search" size={14} /><span class="typing">billing</span><i></i></div>
              <div class="pal-row on"><span class="ty"><Icon name="square-check" size={14} /></span><span class="k">APP-118</span><span><mark>Billing</mark> cron</span><small>In Review · Anna Lee</small></div>
              <div class="pal-row"><span class="ty"><Icon name="bookmark" size={14} /></span><span class="k">APP-131</span><span>New <mark>billing</mark> page</span><small>To do</small></div>
              <div class="pal-row"><span class="ty"><Icon name="sticky-note" size={14} /></span><span>Ask finance about <mark>billing</mark></span><small>in Ideas</small></div>
            </div>
          </div>
        </div>
        <div class="body">
          <h3>Find anything from the keyboard</h3>
          <p><kbd>⌘K</kbd> searches the board and runs commands, and every tool has a shortcut.</p>
          <a class="more" href={`${DOCS}/search/`}>Search <Icon name="arrow-right" /></a>
        </div>
      </article>

      <article class="tile reveal" style="--d:0.16s">
        <div class="visual dots" aria-hidden="true">
          <div class="art team">
            <span class="faces"><i style="--c:var(--p-anna)">AL</i><i style="--c:var(--p-max)">MK</i><i style="--c:var(--p-kim)">KS</i></span>
            <div class="fc held" style="--x:52px;--y:84px">
              <span class="ty"><Icon name="bookmark" size={14} /></span><span class="k">APP-112</span>Retry failed payments
              <span class="held-by">AL</span>
            </div>
            <span class="ptr anna"><svg viewBox="0 0 16 16"><path d="M2 1.5 13.5 7 8.4 8.6 6.6 13.8Z"></path></svg><span class="tag"><i>AL</i><b>Anna</b></span></span>
            <span class="ptr max"><svg viewBox="0 0 16 16"><path d="M2 1.5 13.5 7 8.4 8.6 6.6 13.8Z"></path></svg><span class="tag"><i>MK</i><b>Max</b></span></span>
          </div>
        </div>
        <div class="body">
          <h3>Work on a board together</h3>
          <p>Invite people with a link, as viewers or editors. Everyone sees each other's cursors and changes as they happen.</p>
          <a class="more" href={`${DOCS}/working-together/`}>Working together <Icon name="arrow-right" /></a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .tile {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--card);
  }
  .visual {
    position: relative;
    height: 216px;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background-color: var(--background);
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.25rem 1.375rem;
  }
  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .body p {
    font-size: 0.9375rem;
    color: var(--muted-foreground);
  }
  .body .more {
    margin-top: auto;
    padding-top: 0.5rem;
  }
  kbd {
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--background);
    color: var(--foreground);
  }

  /* Every drawing lives in a 320×200 box in the middle of its tile. */
  .art {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 320px;
    height: 200px;
    margin: -100px 0 0 -160px;
    font-size: 13px;
    line-height: 1.35;
    --r-md: 4.8px;
    --shadow-md: 0 4px 6px -1px oklch(0 0 0 / 0.1), 0 2px 4px -2px oklch(0 0 0 / 0.1);
    --p-anna: oklch(0.58 0.17 340);
    --p-max: oklch(0.58 0.17 165);
    --p-kim: oklch(0.58 0.17 255);
    --tint: 60%;
  }
  :global(:root[data-theme='dark']) .art {
    --tint: 20%;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .art {
      --tint: 20%;
    }
  }
  /* Task card as TaskCardNode draws it: muted type icon, key, title, status in one line. */
  .fc {
    position: absolute;
    left: var(--x, 24px);
    top: var(--y);
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--card);
    line-height: 20px;
    white-space: nowrap;
  }
  .ty {
    display: grid;
    flex: none;
    place-items: center;
    color: var(--muted-foreground);
  }
  .ty :global(svg) {
    width: 14px;
    height: 14px;
  }
  .k {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--primary);
  }
  .lz {
    padding-inline: 4px;
    border-radius: 3px;
    line-height: 16px;
    background: var(--todo);
    color: var(--todo-fg);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .lz.progress {
    background: var(--progress);
    color: var(--progress-fg);
  }
  .lz.done {
    background: var(--done);
    color: var(--done-fg);
  }

  /* Live: one status turns from In review to Done and back. */
  .chip {
    position: absolute;
    right: 20px;
    top: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--muted-foreground);
  }
  .chip i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sync-ok);
    animation: beat 7s infinite;
  }
  .swap {
    display: grid;
  }
  .swap .lz {
    grid-area: 1 / 1;
    justify-self: start;
  }
  .swap .done {
    animation: appear 7s infinite;
  }
  .swap .progress {
    animation: appear 7s infinite reverse;
  }
  .turning .k {
    text-decoration: line-through;
    animation: strike 7s infinite;
  }
  .turning {
    animation: glow 7s infinite;
  }
  @keyframes appear {
    0%,
    42% {
      opacity: 0;
    }
    48%,
    94% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes strike {
    0%,
    42% {
      text-decoration-color: transparent;
    }
    48%,
    94% {
      text-decoration-color: currentColor;
    }
    100% {
      text-decoration-color: transparent;
    }
  }
  @keyframes glow {
    0%,
    43% {
      box-shadow: 0 0 0 0 transparent;
    }
    45% {
      box-shadow: 0 0 0 3px color-mix(in oklch, var(--primary) 40%, transparent);
    }
    58%,
    100% {
      box-shadow: 0 0 0 9px transparent;
    }
  }
  @keyframes beat {
    0%,
    43% {
      box-shadow: 0 0 0 0 transparent;
    }
    45% {
      box-shadow: 0 0 0 0 color-mix(in oklch, var(--sync-ok) 60%, transparent);
    }
    58%,
    100% {
      box-shadow: 0 0 0 7px transparent;
    }
  }

  /* Arrange: a note slides next to another and a guide shows when their tops line up. */
  .fr {
    position: absolute;
    inset: 44px 30px 22px;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: color-mix(in oklch, var(--sticky-green) var(--tint), transparent);
  }
  .fr b {
    position: absolute;
    left: 0;
    bottom: calc(100% + 4px);
    font-size: 13px;
    font-weight: 500;
    color: var(--muted-foreground);
  }
  .st {
    position: absolute;
    left: 54px;
    top: 68px;
    width: 90px;
    height: 86px;
    padding: 12px;
    border-radius: var(--r-md);
    color: var(--sticky-foreground);
    font-size: 14px;
    font-style: normal;
    line-height: 1.35;
  }
  .yellow {
    background: var(--sticky-yellow);
  }
  .blue {
    left: 164px;
    background: var(--sticky-blue);
    animation: slide 6.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  .guide {
    position: absolute;
    left: 44px;
    right: 44px;
    top: 68px;
    border-top: 1px solid var(--primary);
    animation: guide 6.5s infinite;
  }
  @keyframes slide {
    0%,
    18% {
      transform: translate(46px, 26px);
    }
    38%,
    86% {
      transform: none;
    }
    100% {
      transform: translate(46px, 26px);
    }
  }
  @keyframes guide {
    0%,
    34% {
      opacity: 0;
    }
    38%,
    62% {
      opacity: 1;
    }
    70%,
    100% {
      opacity: 0;
    }
  }

  /* Plan: bars grow along the weeks. */
  .gm {
    position: absolute;
    inset: 24px 16px 20px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
  }
  .gm-head {
    display: grid;
    grid-template-columns: 44px repeat(4, 1fr);
    height: 26px;
    border-bottom: 1px solid var(--border);
    font-size: 11px;
    line-height: 26px;
    color: var(--muted-foreground);
    padding-left: 8px;
  }
  .gm-head span {
    padding-left: 6px;
    border-left: 1px solid var(--border);
  }
  .gm-row {
    position: relative;
    height: 36px;
    margin-left: 52px;
  }
  /* Bars as GanttBar draws them: 20 px, radius 4, the type icon and the label inside. */
  .gm-row i {
    position: absolute;
    left: var(--l);
    top: 8px;
    display: flex;
    align-items: center;
    gap: 4px;
    width: var(--w);
    height: 20px;
    padding-inline: 6px;
    overflow: hidden;
    border-radius: 4px;
    background: var(--todo);
    color: var(--todo-fg);
    font-size: 12px;
    font-style: normal;
    font-weight: 500;
    line-height: 20px;
    white-space: nowrap;
    transform-origin: left;
    animation: grow 7s cubic-bezier(0.2, 0.8, 0.2, 1) var(--t, 0s) infinite both;
  }
  .gm-row i :global(svg) {
    flex: none;
    width: 14px;
    height: 14px;
    opacity: 0.8;
  }
  .gm-row i span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .gm-row .progress {
    background: var(--progress);
    color: var(--progress-fg);
  }
  .gm-row .done {
    background: var(--done);
    color: var(--done-fg);
    text-decoration: line-through;
  }
  .gm-today {
    position: absolute;
    left: 58%;
    top: 26px;
    bottom: 0;
    width: 1px;
    background: var(--primary);
  }
  .gm-stone {
    position: absolute;
    right: 20px;
    bottom: 7px;
    width: 10px;
    height: 10px;
    border-radius: 1px;
    background: var(--foreground);
    transform: rotate(45deg);
  }
  @keyframes grow {
    0%,
    8% {
      transform: scaleX(0);
      opacity: 0;
    }
    22%,
    90% {
      transform: none;
      opacity: 1;
    }
    97%,
    100% {
      transform: none;
      opacity: 0;
    }
  }

  /* Wait: the timer by the card runs out and its note appears. */
  .cube {
    position: absolute;
    left: 28px;
    top: 48px;
    display: grid;
    width: 40px;
    height: 40px;
    border-radius: 6px;
    background: var(--timer);
    color: var(--timer-foreground);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    box-shadow: 0 1px 2px oklch(0.3 0.07 60 / 0.25);
    animation: fire 7s infinite;
  }
  .cube span {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 2px;
  }
  .cube :global(svg) {
    width: 14px;
    height: 14px;
    stroke-width: 2;
  }
  .cube .fired {
    animation: appear 7s infinite;
  }
  .cube .run {
    animation: appear 7s infinite reverse;
  }
  /* The note of a timer that went off, as TimerNotes draws it. */
  .went {
    position: absolute;
    left: 28px;
    right: 28px;
    top: 104px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 8px;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
    box-shadow: var(--shadow-md);
    animation: appear 7s infinite;
  }
  .went-cube {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: var(--r-md);
    background: var(--timer-fired);
    color: var(--timer-fired-foreground);
  }
  .went-cube :global(svg) {
    width: 14px;
    height: 14px;
    stroke-width: 2;
  }
  .went b {
    display: block;
    font-weight: 500;
  }
  .went small {
    display: block;
    font-size: 12px;
    color: var(--muted-foreground);
  }
  .went-act {
    grid-column: 2;
    display: flex;
    gap: 4px;
  }
  .went-act i {
    height: 24px;
    padding-inline: 8px;
    border-radius: var(--r-md);
    font-size: 12px;
    font-style: normal;
    font-weight: 500;
    line-height: 24px;
  }
  .went-act .primary {
    background: var(--primary);
    color: var(--primary-foreground);
  }
  @keyframes fire {
    0%,
    42% {
      background: var(--timer);
      color: var(--timer-foreground);
    }
    48%,
    94% {
      background: var(--timer-fired);
      color: var(--timer-fired-foreground);
    }
    100% {
      background: var(--timer);
    }
  }

  /* Find: the palette with a query being typed. */
  .pal {
    position: absolute;
    inset: 16px 10px auto;
    padding-bottom: 6px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
    box-shadow: 0 20px 25px -5px oklch(0 0 0 / 0.1), 0 8px 10px -6px oklch(0 0 0 / 0.1);
  }
  /* Search palette rows: 36 px, kind icon, key, the text cut around the match, muted context. */
  .pal-in {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    margin-bottom: 6px;
    padding-inline: 14px;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
    color: var(--muted-foreground);
  }
  .pal-in :global(svg) {
    width: 16px;
    height: 16px;
  }
  .typing {
    display: inline-block;
    width: 3.3em;
    overflow: hidden;
    color: var(--foreground);
    white-space: nowrap;
    animation: typing 6s steps(7) infinite;
  }
  .pal-in i {
    width: 1px;
    height: 16px;
    margin-left: -6px;
    background: var(--foreground);
    animation: blink 1s steps(2, start) infinite;
  }
  .pal-row {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    margin-inline: 6px;
    padding-inline: 8px;
    border-radius: 6px;
    white-space: nowrap;
  }
  .pal-row.on {
    background: var(--accent);
  }
  .pal-row small {
    margin-left: auto;
    font-size: 12px;
    color: var(--muted-foreground);
  }
  .pal-row :global(svg) {
    color: var(--muted-foreground);
  }
  mark {
    background: color-mix(in oklch, var(--primary) 15%, transparent);
    color: inherit;
  }
  @keyframes typing {
    0%,
    10% {
      width: 0;
    }
    35%,
    100% {
      width: 3.3em;
    }
  }
  @keyframes blink {
    to {
      visibility: hidden;
    }
  }

  /* Together: two people's cursors around a card one of them holds. */
  .faces {
    position: absolute;
    right: 22px;
    top: 14px;
    display: flex;
  }
  .faces i {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-left: -4px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 2px var(--card);
    color: oklch(0.99 0 0);
    font-size: 10px;
    font-style: normal;
    font-weight: 600;
  }
  /* Someone else's selection: a 2 px outline in their color inside the element, their avatar on the corner. */
  .held {
    outline: 2px solid var(--p-anna);
    outline-offset: -2px;
    animation: carry 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  .held-by {
    position: absolute;
    right: -8px;
    top: -8px;
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--p-anna);
    box-shadow: 0 0 0 1px var(--card);
    color: oklch(0.99 0 0);
    font-size: 7px;
    font-weight: 600;
  }

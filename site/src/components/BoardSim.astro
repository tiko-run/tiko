---
// The hero board: a drawing of the canvas in DOM and CSS, not the real one. The markup is the
// finished scene, so it reads without scripts or motion; board.ts rewinds it and plays it.
import Icon from './Icon.astro'

const cards = [
  { id: 'c1', key: 'APP-112', title: 'Retry failed payments', type: 'story', status: 'progress' },
  { id: 'c2', key: 'APP-118', title: 'Move billing cron to a queue', type: 'task', status: 'done' },
  { id: 'c3', key: 'APP-121', title: 'Release notes for 2.4', type: 'task', status: 'todo' },
  { id: 'c4', key: 'APP-127', title: 'Flaky login test', type: 'bug', status: 'todo' },
]
const waiting = [
  { key: 'OPS-41', type: 'task', status: 'todo' },
  { key: 'OPS-44', type: 'task', status: 'done' },
  { key: 'WEB-9', type: 'story', status: 'review' },
]
const STATUS = { todo: 'To do', progress: 'In progress', review: 'In review', done: 'Done' }
// The app's own type icons for demo tasks: muted lucide outlines, as in TaskBits.
const TYPE_ICON = { story: 'bookmark', task: 'square-check', bug: 'bug' }
const tools = ['mouse-pointer-2', 'hand', 'frame', 'sticky-note', 'type', 'alarm-clock', 'shapes']
---

<div class="stage">
  <div
    class="board dots"
    data-board
    role="img"
    aria-label="A tiko board: a sprint frame with four live task cards, a sticky note, a reminder that went off and a Gantt plan of the release."
  >
    <svg class="wires" viewBox="0 0 1120 600" aria-hidden="true">
      <path d="M490 236 C 508 236, 500 322, 514 322" />
      <path class="head" d="M507 317 L515 322 L507 327" />
    </svg>

    <div class="n bar topbar">
      <span class="tb-btn"><Icon name="menu" size={18} /></span>
      <span class="tb-name">Release 2.4 <Icon name="chevron-down" size={14} /></span>
      <span class="tb-share"><Icon name="share-2" size={14} />Share</span>
      <span class="faces"><i style="--c:var(--p-anna)">AL</i><i style="--c:var(--p-max)">MK</i></span>
    </div>

    <div class="n capsule">
      <div class="dial">
        <span class="cap-icon"><Icon name="target" size={18} /></span>
        <span class="cap-mid">
          <span class="cap-time">24:10</span>
          <span class="cap-dots"><i class="on"></i><i class="on"></i><i></i><i></i></span>
        </span>
        <span class="cap-play"><Icon name="pause" size={14} /></span>
      </div>
      <div class="deck">
        <span class="eq"><i></i><i></i><i></i></span>
        <span class="track">Rain on a tin roof <span>· Ambient</span></span>
        <Icon name="pause" size={13} />
        <Icon name="skip-forward" size={13} />
        <Icon name="sliders-horizontal" size={14} />
      </div>
    </div>

    <div class="n corner">
      <span class="bar timers"><Icon name="alarm-clock" size={16} />1</span>
      <span class="bar sync" data-sync>
        <span class="sync-state"><i></i><span data-sync-text>Synced just now</span></span>
        <span class="sync-refresh"><Icon name="refresh-cw" size={14} />Refresh all</span>
      </span>
    </div>

    <div class="n frame"><span class="frame-title">Sprint 24</span></div>

    {
      cards.map((card) => (
        <div class={`n card ${card.id}`} data-card={card.id} data-status={card.status} data-drag>
          <span class="type">
            <Icon name={TYPE_ICON[card.type as keyof typeof TYPE_ICON]} size={14} />
          </span>
          <span class="key">{card.key}</span>
          <span class="title">{card.title}</span>
          <span class="lozenge" data-lozenge>
            {STATUS[card.status as keyof typeof STATUS]}
          </span>
        </div>
      ))
    }

    <div class="n frame frame2"><span class="frame-title">Waiting on others</span></div>
    {
      waiting.map((card, i) => (
        <div class={`n card mini w${i + 1}`} data-status={card.status} data-drag>
          <span class="type">
            <Icon name={TYPE_ICON[card.type as keyof typeof TYPE_ICON]} size={14} />
          </span>
          <span class="key">{card.key}</span>
          <span class="lozenge">{STATUS[card.status as keyof typeof STATUS]}</span>
        </div>
      ))
    }

    <div class="n sticky" data-sticky data-drag>Ship on Thursday.<br />Code freeze Wed 18:00.</div>

    <div class="n timer" data-timer data-state="fired" data-drag>
      <span class="timer-bell"><Icon name="bell-ring" size={14} /></span>
      <span class="timer-clock"><Icon name="alarm-clock" size={14} /></span>
      <span class="timer-left" data-timer-left>3s</span>
    </div>

    <div class="n note" data-note>
      <span class="note-cube"><Icon name="bell-ring" size={14} /></span>
      <span class="note-text">
        <b>Ping QA about the cron</b>
        <small>On APP-118 · Went off at 15:30</small>
      </span>
      <span class="note-actions"><i class="primary">Done</i><i>+10 min</i><i>+1 hour</i></span>
    </div>

    <div class="n gantt">
      <div class="g-head"><Icon name="chart-gantt" size={16} /> Release 2.4</div>
      <div class="g-scale">
        <span class="g-range">Oct 5 – Nov 1, 2026</span>
        <span class="g-month">October 2026</span>
        <span class="g-weeks"><i>5–11</i><i>12–18</i><i>19–25</i><i>26–1</i></span>
      </div>
      <div class="g-rows">
        <span class="g-today"></span>
        <span class="g-mline" data-gantt-row></span>
        <svg class="g-dep" data-gantt-row viewBox="0 0 388 96" preserveAspectRatio="none" aria-hidden="true">
          <path d="M222 48 H232 V80 H242" />
          <path class="g-arrow" d="M238 76.5 L244 80 L238 83.5 Z" />
        </svg>
        <div class="g-row" data-gantt-row>
          <span class="g-label"><Icon class="grip" name="grip-vertical" size={14} /><Icon name="bookmark" size={14} /><b>APP-112</b><span class="g-t">Retry payments</span></span>
          <span class="g-track"><i class="g-bar b1" data-bar="c1" data-status="progress"><Icon name="bookmark" size={14} /><span class="g-bl">APP-112 Retry payments</span></i></span>
        </div>
        <div class="g-row" data-gantt-row>
          <span class="g-label"><Icon class="grip" name="grip-vertical" size={14} /><Icon name="square-check" size={14} /><b>APP-118</b><span class="g-t">Billing cron</span></span>
          <span class="g-track"><i class="g-bar b2" data-bar="c2" data-status="done"><Icon name="square-check" size={14} /><span class="g-bl">APP-118 Billing cron</span></i></span>
        </div>
        <div class="g-row" data-gantt-row>
          <span class="g-label"><Icon class="grip" name="grip-vertical" size={14} /><Icon name="square-check" size={14} /><b>APP-121</b><span class="g-t">Release notes</span></span>
          <span class="g-track"><i class="g-bar b3" data-bar="c3" data-status="todo"><Icon name="square-check" size={14} /><span class="g-bl">APP-121 Release notes</span></i></span>
        </div>
      </div>
      <div class="g-foot"><span class="g-add"><Icon name="plus" size={14} />Add</span><span class="g-stone" data-gantt-row><i></i>2.4 out</span></div>
    </div>

    <div class="n popover out" data-popover>
      <span class="pop-hint">Issue keys, links or JQL</span>
      <span class="pop-input"><span data-typed></span><i class="caret"></i></span>
    </div>

    <div class="n bar toolbar">
      {tools.map((tool, i) => <span class:list={{ active: i === 0 }} data-tool={tool}><Icon name={tool} size={18} /></span>)}
      <span data-tool="card"><Icon name="ticket-plus" size={18} /></span>
      <span><Icon name="layout-template" size={18} /></span>
    </div>

    <div class="n cursor out" data-cursor>
      <svg viewBox="0 0 16 16" width="16" height="16"><path d="M2 1.5 13.5 7 8.4 8.6 6.6 13.8Z" /></svg>
      <span class="cur-tag"><i>AL</i><b>Anna</b></span>
    </div>
  </div>

  <div class="controls">
    <span class="hint" data-hint><Icon name="hand" size={13} /> Drag a card</span>
    <button class="replay" type="button" data-replay hidden><Icon name="rotate-ccw" size={13} /> Replay</button>
  </div>
</div>

<script>
  import '../scripts/board'
</script>

<style>
  /* One board unit is a pixel at full width: every size below is a number of units, so the
     whole board scales with its width and keeps its proportions. */
  .stage {
    position: relative;
    container-type: inline-size;
  }
  .board {
    --u: calc(100cqw / 1120);
    position: relative;
    aspect-ratio: 1120 / 600;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    background-color: var(--background);
    background-size: calc(20 * var(--u)) calc(20 * var(--u));
    box-shadow: var(--shadow);
    font-size: calc(13 * var(--u));
    line-height: 1.35;
    user-select: none;
  }
  .n {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    transition:
      opacity 0.35s,
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .n.out {
    opacity: 0;
    transform: scale(0.96);
    pointer-events: none;
  }
  [data-drag] {
    cursor: grab;
    touch-action: none;
  }
  [data-drag].dragging {
    z-index: 5;
    cursor: grabbing;
    transition: none;
  }
  .gliding {
    transition:
      left 0.9s cubic-bezier(0.4, 0, 0.2, 1),
      top 0.9s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.35s;
  }

  .wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--muted-foreground);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.7;
  }

  /* Sizes below follow the app's components in board units: radius-md 4.8, radius-lg 6, shadow-md. */
  .board {
    --r-md: calc(4.8 * var(--u));
    --r-lg: calc(6 * var(--u));
    --shadow-md: 0 calc(4 * var(--u)) calc(6 * var(--u)) calc(-1 * var(--u)) oklch(0 0 0 / 0.1),
      0 calc(2 * var(--u)) calc(4 * var(--u)) calc(-2 * var(--u)) oklch(0 0 0 / 0.1);
    --p-anna: oklch(0.58 0.17 340);
    --p-max: oklch(0.58 0.17 165);
    --tint: 60%;
  }
  :global(:root[data-theme='dark']) .board {
    --tint: 20%;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .board {
      --tint: 20%;
    }
  }

  /* Floating bars share one surface: card, border, radius-lg, 4 px padding, shadow-md. */
  .bar {
    display: flex;
    align-items: center;
    padding: calc(4 * var(--u));
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--card);
    box-shadow: var(--shadow-md);
    white-space: nowrap;
  }
  .bar :global(svg) {
    width: calc(var(--i, 16) * var(--u));
    height: calc(var(--i, 16) * var(--u));
    stroke-width: 1.75;
  }
  .topbar {
    --x: 16;
    --y: 16;
    gap: calc(4 * var(--u));
    font-size: calc(14 * var(--u));
  }
  .topbar > span {
    display: flex;
    align-items: center;
    gap: calc(6 * var(--u));
    height: calc(32 * var(--u));
    padding-inline: calc(10 * var(--u));
    border-radius: var(--r-md);
  }
  .topbar .tb-btn {
    --i: 18;
    justify-content: center;
    width: calc(32 * var(--u));
    padding: 0;
  }
  .tb-name :global(svg) {
    --i: 14;
    color: var(--muted-foreground);
  }
  .tb-share :global(svg) {
    --i: 14;
  }
  .topbar .faces {
    gap: 0;
    padding-inline: calc(4 * var(--u)) calc(6 * var(--u));
  }
  .faces i {
    display: grid;
    place-items: center;
    width: calc(24 * var(--u));
    height: calc(24 * var(--u));
    margin-left: calc(-4 * var(--u));
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 calc(2 * var(--u)) var(--card);
    color: oklch(0.99 0 0);
    font-size: calc(10 * var(--u));
    font-style: normal;
    font-weight: 600;
  }
  .faces i:first-child {
    margin-left: 0;
  }

  /* The focus capsule: the dial on the timer's tint over the music deck. */
  .capsule {
    --x: 428;
    --y: 16;
    width: calc(264 * var(--u));
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: calc(26 * var(--u)) calc(26 * var(--u)) calc(12 * var(--u)) calc(12 * var(--u));
    background: var(--card);
    box-shadow: var(--shadow-md);
  }
  .dial {
    display: grid;
    grid-template-columns: calc(36 * var(--u)) 1fr calc(36 * var(--u));
    gap: calc(6 * var(--u));
    align-items: center;
    height: calc(56 * var(--u));
    padding-inline: calc(10 * var(--u));
    border-bottom: 1px solid color-mix(in oklch, var(--focus-ink) 18%, transparent);
    background: linear-gradient(100deg, var(--focus-fill), var(--focus-fill-2), var(--focus-fill));
    color: var(--focus-ink);
  }
  .cap-icon,
  .cap-play {
    display: grid;
    place-items: center;
    border-radius: 50%;
  }
  .cap-icon {
    width: calc(32 * var(--u));
    height: calc(32 * var(--u));
    background: color-mix(in oklch, var(--focus-ink) 8%, transparent);
  }
  .cap-icon :global(svg) {
    width: calc(18 * var(--u));
    height: calc(18 * var(--u));
  }
  .cap-play {
    justify-self: end;
    width: calc(34 * var(--u));
    height: calc(34 * var(--u));
    background: var(--focus-ink);
    color: var(--focus-fill);
  }
  .cap-play :global(svg) {
    width: calc(16 * var(--u));
    height: calc(16 * var(--u));
    fill: currentColor;
    stroke-width: 0;
  }
  .cap-mid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(3 * var(--u));
  }
  .cap-time {
    font-family: var(--mono);
    font-size: calc(28 * var(--u));
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .cap-dots {
    display: flex;
    gap: calc(4 * var(--u));
  }
  .cap-dots i {
    width: calc(6 * var(--u));
    height: calc(6 * var(--u));
    border: calc(1.25 * var(--u)) solid color-mix(in oklch, var(--focus-ink) 60%, transparent);
    border-radius: 50%;
  }
  .cap-dots i.on {
    border-color: var(--focus-ink);
    background: var(--focus-ink);
  }
  .deck {
    display: flex;
    align-items: center;
    gap: calc(2 * var(--u));
    height: calc(36 * var(--u));
    padding: 0 calc(6 * var(--u)) 0 calc(14 * var(--u));
    color: var(--muted-foreground);
  }
  .deck > :global(svg) {
    box-sizing: content-box;
    width: calc(13 * var(--u));
    height: calc(13 * var(--u));
    padding: calc(5 * var(--u));
  }
  .deck > :global(svg):first-of-type {
    fill: currentColor;
    stroke-width: 0;
  }
  .eq {
    display: flex;
    align-items: flex-end;
    gap: calc(2 * var(--u));
    width: calc(13 * var(--u));
    height: calc(11 * var(--u));
    color: var(--foreground);
  }
  .eq i {
    flex: 1;
    height: 60%;
    border-radius: 1px;
    background: currentColor;
    animation: boardsim-eq 0.9s ease-in-out infinite alternate;
  }
  .eq i:nth-child(2) {
    height: 100%;
    animation-delay: -0.3s;
  }
  .eq i:nth-child(3) {
    height: 40%;
    animation-delay: -0.6s;
  }
  @keyframes boardsim-eq {
    to {
      transform: scaleY(0.35);
      transform-origin: bottom;
    }
  }
  .track {
    flex: 1;
    min-width: 0;
    margin-left: calc(6 * var(--u));
    overflow: hidden;
    color: var(--foreground);
    font-size: calc(12 * var(--u));
    text-overflow: ellipsis;
  }
  .track span {
    color: var(--muted-foreground);
  }

  /* Top right: the timer list button, then the sync indicator with Refresh all. */
  .corner {
    left: auto;
    right: calc(16 * var(--u));
    top: calc(16 * var(--u));
    display: flex;
    gap: calc(8 * var(--u));
    font-size: calc(13 * var(--u));
  }
  .timers {
    gap: calc(6 * var(--u));
    height: calc(42 * var(--u));
    padding-inline: calc(12 * var(--u));
    font-variant-numeric: tabular-nums;
  }
  .sync {
    height: calc(42 * var(--u));
    gap: calc(4 * var(--u));
  }
  .sync-state,
  .sync-refresh {
    display: flex;
    align-items: center;
    gap: calc(8 * var(--u));
    height: calc(32 * var(--u));
    padding-inline: calc(10 * var(--u));
  }
  .sync-state {
    color: var(--muted-foreground);
  }
  .sync-refresh {
    --i: 14;
    gap: calc(6 * var(--u));
  }
  .sync i {
    width: calc(10 * var(--u));
    height: calc(10 * var(--u));
    border-radius: 50%;
    background: var(--sync-ok);
  }
  .sync.pulse i {
    animation: boardsim-sync-pulse 0.9s ease-out;
  }
  @keyframes boardsim-sync-pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in oklch, var(--sync-ok) 60%, transparent);
    }
    to {
      box-shadow: 0 0 0 calc(8 * var(--u)) transparent;
    }
  }

  /* Frames: a plain one on muted at 40%, a tinted one in a sticky color at the frame tint. */
  .frame {
    --x: 40;
    --y: 132;
    width: calc(450 * var(--u));
    height: calc(184 * var(--u));
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--muted) 40%, transparent);
  }
  .frame2 {
    --y: 368;
    height: calc(62 * var(--u));
    background: color-mix(in oklab, var(--sticky-green) var(--tint), transparent);
  }
  .card.mini {
    --y: 386;
    padding-block: calc(1 * var(--u));
  }
  .card.w1 {
    --x: 56;
  }
  .card.w2 {
    --x: 190;
  }
  .card.w3 {
    --x: 330;
  }
  .frame-title {
    position: absolute;
    left: 0;
    bottom: calc(100% + 4 * var(--u));
    font-size: calc(13 * var(--u));
    font-weight: 500;
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  /* Task card: one inline line, type icon, key, title, status, as TaskCardNode draws it. */
  .card {
    --x: 60;
    display: flex;
    align-items: center;
    gap: calc(6 * var(--u));
    padding: calc(4 * var(--u)) calc(8 * var(--u));
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--card);
    color: var(--foreground);
    line-height: calc(20 * var(--u));
    white-space: nowrap;
  }
  .c1 {
    --y: 150;
  }
  .c2 {
    --y: 190;
  }
  .c3 {
    --y: 230;
  }
  .c4 {
    --y: 270;
  }
  .type {
    display: grid;
    place-items: center;
    flex: none;
    color: var(--muted-foreground);
  }
  .type :global(svg) {
    width: calc(14 * var(--u));
    height: calc(14 * var(--u));
  }
  .key {
    font-family: var(--mono);
    font-size: calc(12 * var(--u));
    font-variant-numeric: tabular-nums;
    color: var(--primary);
  }
  .lozenge {
    padding-inline: calc(4 * var(--u));
    border-radius: calc(3 * var(--u));
    background: var(--todo);
    color: var(--todo-fg);
    font-size: calc(11 * var(--u));
    font-weight: 600;
    line-height: calc(16 * var(--u));
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition:
      background-color 0.3s,
      color 0.3s;
  }
  [data-status='progress'] .lozenge,
  [data-status='review'] .lozenge {
    background: var(--progress);
    color: var(--progress-fg);
  }
  [data-status='done'] .lozenge {
    background: var(--done);
    color: var(--done-fg);
  }
  [data-status='done'] .key {
    text-decoration: line-through;
  }
  [data-status='done'] .title {
    color: var(--muted-foreground);
  }
  .card.flash {
    animation: boardsim-flash 0.9s ease-out;
  }
  @keyframes boardsim-flash {
    from {
      box-shadow: 0 0 0 calc(3 * var(--u)) color-mix(in oklch, var(--primary) 45%, transparent);
    }
    to {
      box-shadow: 0 0 0 calc(10 * var(--u)) transparent;
    }
  }

  /* Sticky note: flat, radius-md, 12 px padding, 14 px text at 1.35. */
  .sticky {
    --x: 520;
    --y: 132;
    width: calc(156 * var(--u));
    height: calc(96 * var(--u));
    padding: calc(12 * var(--u));
    border-radius: var(--r-md);
    background: var(--sticky-yellow);
    color: var(--sticky-foreground);
    font-size: calc(14 * var(--u));
    line-height: 1.35;
  }

  /* Timer cube: 40 px, radius-lg, 14 px icon over 11 px mono time. */
  .timer {
    --x: 696;
    --y: 132;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(2 * var(--u));
    width: calc(40 * var(--u));
    height: calc(40 * var(--u));
    border-radius: var(--r-lg);
    background: var(--timer);
    color: var(--timer-foreground);
    font-family: var(--mono);
    font-size: calc(11 * var(--u));
    font-weight: 600;
    line-height: 1;

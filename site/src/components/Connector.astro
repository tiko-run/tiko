---
// The arrow from one frame to the next. Scrolling draws it: the line grows and its head rides
// on the line's end, both on one timeline. Without scroll timelines it stands drawn.
---

<div class="link" aria-hidden="true">
  <i class="stem"></i>
  <svg class="tip" viewBox="0 0 14 8"><path d="M1 1 L7 7 L13 1"></path></svg>
</div>

<style>
  .link {
    --len: 104px;
    position: relative;
    width: 14px;
    height: calc(var(--len) + 8px);
    margin: 0 auto 1rem;
    color: var(--muted-foreground);
    opacity: 0.75;
    view-timeline: --link block;
  }
  .stem {
    position: absolute;
    left: 6.25px;
    top: 0;
    width: 1.5px;
    height: var(--len);
    border-radius: 1px;
    background: currentColor;
    transform-origin: 50% 0;
  }
  .tip {
    position: absolute;
    left: 0;
    top: calc(var(--len) - 6px);
    width: 14px;
    height: 8px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stem,
      .tip {
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --link;
        animation-range: entry 20% cover 50%;
      }
      .stem {
        animation-name: connector-grow;
      }
      .tip {
        animation-name: connector-ride;
      }
    }
  }
  @keyframes connector-grow {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes connector-ride {
    from {
      opacity: 0;
      translate: 0 calc(-1 * var(--len) + 6px);
    }
    10% {
      opacity: 1;
    }
  }
</style>

const place = ([x, y, w, h]: number[]) =>
  `--x:${x};--y:${y}` + (w ? `;--w:${w}` : '') + (h ? `;--h:${h}` : '')
---

<section class="section alt" id="scenarios">
  <div class="wrap">
    <div class="head">
      <div>
        <h2 class="h2 reveal">One canvas, many ways to lay work out</h2>
        <p class="lead reveal">A board has no fixed shape. Ten layouts to start from, for sprints, releases, incidents and your own week.</p>
      </div>
      <div class="nav" data-nav hidden>
        <button type="button" class="btn btn-outline btn-sm" data-dir="-1" aria-label="Previous layouts"><Icon name="arrow-left" /></button>
        <button type="button" class="btn btn-outline btn-sm" data-dir="1" aria-label="Next layouts"><Icon name="arrow-right" /></button>
      </div>
    </div>
    <div class="track" data-track tabindex="0" aria-label="Board layouts">
      {
        scenarios.map(({ tag, title, text, items }) => (
          <article>
            <div class="thumb" aria-hidden="true">
              <div class="mini dots">
                <svg class="arrows" viewBox="0 0 400 250">
                  {items.map((item) => item.t === 'arrow' && <path d={item.d} />)}
                </svg>
                {items.map((item) => {
                  if (item.t === 'arrow') return null
                  if (item.t === 'frame')
                    return <div class={`n frame ${item.tone ?? 'plain'}`} style={place(item.at)}><b>{item.title}</b></div>
                  if (item.t === 'card')
                    return (
                      <div class="n card" data-status={item.s} style={place(item.at)}>
                        <span class="ty"><Icon name={TYPE_ICON[item.type ?? 'task']} size={10} /></span>
                        <span class="k">{item.k}</span>
                        <span class="lz">{STATUS[item.s]}</span>
                      </div>
                    )
                  if (item.t === 'note')
                    return <div class={`n note ${item.tone}`} style={place(item.at)}>{item.text}</div>
                  if (item.t === 'timer')
                    return <div class="n timer" style={place(item.at)}>{item.left}</div>
                  if (item.t === 'focus')
                    return <div class="n focus" style={place(item.at)}><i />{item.time}<i class="play" /></div>
                  return (
                    <div class="n gantt" style={place(item.at)}>
                      <b>{item.title}</b>
                      {item.bars.map(([left, width, status]) => (
                        <span class="row"><i class={status} style={`left:${left}%;width:${width}%`} /></span>
                      ))}
                      <i class="today" />
                      <i class="stone" />
                    </div>
                  )
                })}
              </div>
            </div>
            <span class="tag">{tag}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Arrow buttons page the carousel by its visible width; without scripts it still scrolls.
  const track = document.querySelector<HTMLElement>('[data-track]')
  const nav = document.querySelector<HTMLElement>('[data-nav]')
  if (track && nav) {
    nav.hidden = false
    const [back, next] = nav.querySelectorAll<HTMLButtonElement>('button')
    const update = () => {
      back.disabled = track.scrollLeft < 4
      next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 4
    }
    for (const button of [back, next])
      button.addEventListener('click', () =>
        track.scrollBy({ left: Number(button.dataset.dir) * track.clientWidth * 0.9, behavior: 'smooth' }),
      )
    track.addEventListener('scroll', update, { passive: true })
    update()

    // Grab and pan with a mouse, like the canvas; touch already scrolls natively. On release
    // the row eases to the nearest board.
    track.addEventListener('pointerdown', (down) => {
      if (down.pointerType !== 'mouse' || down.button !== 0) return
      const startLeft = track.scrollLeft
      let moved = false
      const move = (event: PointerEvent) => {
        const dx = event.clientX - down.clientX
        if (!moved && Math.abs(dx) < 4) return
        if (!moved) {
          moved = true
          track.setPointerCapture(down.pointerId)
          track.classList.add('grabbing')
        }
        track.scrollLeft = startLeft - dx
      }
      const up = () => {
        track.removeEventListener('pointermove', move)
        track.removeEventListener('pointerup', up)
        track.removeEventListener('pointercancel', up)
        if (!moved) return
        const boards = [...track.children] as HTMLElement[]
        const near = boards.reduce((a, b) =>
          Math.abs(b.offsetLeft - track.offsetLeft - track.scrollLeft) <
          Math.abs(a.offsetLeft - track.offsetLeft - track.scrollLeft)
            ? b
            : a,
        )
        track.scrollTo({ left: near.offsetLeft - track.offsetLeft, behavior: 'smooth' })
        // Snapping comes back once the row has settled, so it does not jump mid-glide.
        setTimeout(() => track.classList.remove('grabbing'), 500)
        // A drag is not a click on whatever sits under the pointer.
        track.addEventListener('click', (e) => e.preventDefault(), { capture: true, once: true })
      }
      track.addEventListener('pointermove', move)
      track.addEventListener('pointerup', up)
      track.addEventListener('pointercancel', up)
    })

  }
</script>

<style>
  .alt {
    border-block: 1px solid var(--border);
    background: var(--card);
  }
  .head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .nav {
    display: flex;
    flex: none;
    gap: 0.5rem;
  }
  .nav[hidden] {
    display: none;
  }
  .nav .btn {
    width: 2.25rem;
    padding: 0;
  }
  .nav .btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  /* A row that scrolls and snaps; three boards in view on a wide screen. */
  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3rem) / 3);
    gap: 1.5rem;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--muted-foreground) 35%, transparent) transparent;
  }
  .track:focus-visible {
    outline-offset: 6px;
  }
  @media (pointer: fine) {
    .track {
      cursor: grab;
    }
  }
  /* While dragged the row follows the pointer freely; it snaps again on release. */
  .track.grabbing {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }
  .track article {
    scroll-snap-align: start;
  }
  @media (max-width: 960px) {
    .track {
      grid-auto-columns: calc((100% - 1.5rem) / 2);
    }
  }
  @media (max-width: 640px) {
    .track {
      grid-auto-columns: 86%;
    }
    .nav {
      display: none;
    }
  }
  /* Like the hero board: one unit is a pixel of a 400×250 board, scaled to the thumbnail. */
  .thumb {
    container-type: inline-size;
    margin-bottom: 1rem;
  }
  .mini {
    --u: calc(100cqw / 400);
    position: relative;
    aspect-ratio: 400 / 250;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
    background-color: var(--background);
    background-size: calc(16 * var(--u)) calc(16 * var(--u));
    font-size: calc(9 * var(--u));
    line-height: 1.3;
    transition: border-color 0.2s;
  }
  article:hover .mini {
    border-color: color-mix(in oklch, var(--primary) 45%, var(--border));
  }
  .arrows {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--foreground);
    stroke-width: 1.25;
    stroke-linecap: round;
    opacity: 0.55;
  }
  .n {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
  }
  /* Frames and notes as on the board: a plain frame on --muted, a filled one tinted. */
  .frame {
    border: 1px solid var(--border);
    border-radius: calc(3.4 * var(--u));
    background: color-mix(in oklab, var(--tone) var(--frame-tint), var(--background));
  }
  .frame.plain {
    background: color-mix(in oklab, var(--muted) 40%, transparent);
  }
  .frame b {
    position: absolute;
    left: 0;
    bottom: calc(100% + 3 * var(--u));
    font-size: calc(9.5 * var(--u));
    font-weight: 500;
    color: var(--muted-foreground);
    white-space: nowrap;
  }
  .green {
    --tone: var(--sticky-green);
  }
  .yellow {
    --tone: var(--sticky-yellow);
  }
  .pink {
    --tone: var(--sticky-pink);
  }
  .violet {
    --tone: var(--sticky-violet);
  }
  .orange {
    --tone: var(--sticky-orange);
  }
  .blue {
    --tone: var(--sticky-blue);
  }
  .card {
    display: flex;
    align-items: center;
    gap: calc(4 * var(--u));
    width: auto;
    height: auto;
    padding: calc(3 * var(--u)) calc(6 * var(--u));
    border: 1px solid var(--border);
    border-radius: calc(3.4 * var(--u));
    background: var(--card);
    white-space: nowrap;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  article:hover .card:nth-of-type(odd) {
    transform: translateX(calc(3 * var(--u)));
  }
  /* The type icon is a muted outline, as on demo cards. */
  .ty {
    display: grid;
    color: var(--muted-foreground);
  }
  .ty :global(svg) {
    width: calc(10 * var(--u));
    height: calc(10 * var(--u));
  }
  .k {
    font-family: var(--mono);
    font-size: calc(8 * var(--u));
    color: var(--primary);
  }
  .lz {
    padding: 0 calc(3 * var(--u));
    border-radius: calc(2 * var(--u));
    background: var(--todo);
    color: var(--todo-fg);
    font-size: calc(7 * var(--u));
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  [data-status='progress'] .lz,
  [data-status='review'] .lz {
    background: var(--progress);
    color: var(--progress-fg);
  }
  [data-status='done'] .lz {
    background: var(--done);
    color: var(--done-fg);
  }
  [data-status='done'] .k {
    text-decoration: line-through;
  }
  .note {
    padding: calc(8 * var(--u));
    border-radius: calc(3.4 * var(--u));
    background: var(--tone);
    color: var(--sticky-foreground);
    font-size: calc(9.5 * var(--u));
    line-height: 1.35;

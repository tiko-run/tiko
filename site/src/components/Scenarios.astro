---
// Ways to lay a board out, drawn as small boards in the look of the real one, in a carousel.
// Not customer stories: every key, name and note here is made up.
import Icon from './Icon.astro'

type Tone = 'blue' | 'green' | 'yellow' | 'pink' | 'violet' | 'orange'
type Status = 'todo' | 'progress' | 'review' | 'done'
type Item =
  | { t: 'frame'; at: number[]; title: string; tone?: Tone }
  | { t: 'card'; at: number[]; k: string; s: Status; type?: 'story' | 'task' | 'bug' }
  | { t: 'note'; at: number[]; text: string; tone: Tone }
  | { t: 'timer'; at: number[]; left: string; fired?: boolean }
  | { t: 'gantt'; at: number[]; title: string; bars: [number, number, 'todo' | 'progress' | 'done'][] }
  | { t: 'focus'; at: number[]; time: string }
  | { t: 'arrow'; d: string }

const STATUS = { todo: 'To do', progress: 'In progress', review: 'In review', done: 'Done' }
const TYPE_ICON = { story: 'bookmark', task: 'square-check', bug: 'bug' }


---
import { DEMO, DOCS, REPO } from '../data/site'
import Brand from './Brand.astro'
import Mark from './Mark.astro'
import ThemeSwitch from './ThemeSwitch.astro'
---

<header class="header">
  <div class="wrap row">
    <a class="home" href="/" aria-label="tiko, home"><Brand height={26} /></a>
    <nav aria-label="Main">
      <a href="/#features">Features</a>
      <a href="/#scenarios">Scenarios</a>
      <a href="/#self-host">Self-host</a>
      <a href={`${DOCS}/`}>Docs</a>
      <a href={`${DOCS}/roadmap/`}>Roadmap</a>
    </nav>
    <div class="side">
      <a class="github" href={REPO} aria-label="tiko on GitHub"><Mark tracker="github" size={18} /><span>GitHub</span></a>
      <ThemeSwitch />
      <a class="btn btn-primary btn-sm" href={DEMO}>Try the demo</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 70%, transparent);
    background: color-mix(in oklch, var(--background) 82%, transparent);
    backdrop-filter: blur(12px);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 3.75rem;
  }
  .home {
    display: flex;
    color: var(--foreground);
  }
  nav {
    display: flex;
    gap: 0.25rem;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
  nav a {
    padding: 0.375rem 0.625rem;
    border-radius: 6px;
  }
  nav a:hover,
  .github:hover {
    color: var(--foreground);
    background: var(--muted);
  }
  .side {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }
  .github {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    padding-inline: 0.625rem;
    border-radius: 8px;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
  .github :global(svg) {
    color: var(--foreground);
  }
  .side .btn {
    margin-left: 0.5rem;
  }
  @media (max-width: 860px) {
    nav {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .github span {
      display: none;
    }
  }
</style>

---
import { DOCS, INSTALL_PS1, INSTALL_SH } from '../data/site'
import Command from './Command.astro'
import Icon from './Icon.astro'
import Waitlist from './Waitlist.astro'

const points = [
  { icon: 'database', title: 'One SQLite file', text: 'Boards, people and settings live in one file on your server, with no database to run.' },
  { icon: 'lock', title: 'Tokens stay on the server', text: 'Tracker tokens are encrypted and never sent back to the browser or written to logs.' },
  { icon: 'eye', title: 'Your tracker stays in charge', text: 'Cards show tasks as they are in your tracker. Each person uses their own token and sees what their access allows.' },
  { icon: 'shield-check', title: 'Anonymous counts only', text: 'A daily ping with the version and rough counts, never people or board contents. Error reports are off by default. Each turns off with one setting.', href: 'https://docs.tiko.run/privacy/' },
]
const RAILWAY =
  'https://railway.com/deploy/tiko?referralCode=wFuy8y&utm_medium=integration&utm_source=button&utm_campaign=tiko'
const RENDER = 'https://render.com/deploy?repo=https://github.com/tiko-run/tiko'
---

<section class="section" id="self-host">
  <div class="wrap cols">
    <div>
      <h2 class="h2 reveal">Running on your server in a few minutes</h2>
      <p class="lead reveal">
        The installer sets up Docker if it is missing, starts the latest release and prints the
        address and the password. A fresh install opens on a sample board, so you can try
        everything before you connect a tracker.
      </p>

      <div class="install reveal">
        <p class="os">Linux, macOS</p>
        <Command text={INSTALL_SH} />
        <p class="os">Windows 10, 11 (PowerShell)</p>
        <Command text={INSTALL_PS1} prompt=">" />
      </div>

      <p class="other reveal">
        Or <a class="link" href={`${DOCS}/install/`}>run Docker Compose yourself</a>, deploy on <a class="link" href={RAILWAY}>Railway</a> or <a class="link" href={RENDER}>Render</a>.
      </p>

      <div class="reveal"><Waitlist source="self-host" /></div>
    </div>

    <ul class="points reveal">
      {
        points.map(({ icon, title, text, href }) => (
          <li>
            <h3><Icon name={icon} size={16} />{title}</h3>
            <p>
              {text}{' '}
              {href && <a class="link" href={href}>What is sent</a>}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  @media (max-width: 900px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .install {
    display: grid;
    gap: 0.5rem;
    max-width: 34rem;
    margin-top: 2rem;
  }
  .os {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }
  .other {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    color: var(--muted-foreground);
  }
  .points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--border);
  }
  @media (max-width: 480px) {
    .points {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .points li {
    padding: 1.25rem;
    background: var(--card);
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  h3 :global(svg) {
    color: var(--muted-foreground);
  }
  .points p {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
</style>

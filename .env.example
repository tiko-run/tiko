# Copy to .env to override defaults. Everything works without this file.
APP_ENV=local
LOG_LEVEL=info
# The password of Postgres in the db service; the installers write a random one. Read once, when
# the database volume is made: a new value later locks tiko out of its data. Letters and digits
# only, it goes into a URL. Empty: tiko-local, for a machine of your own.
POSTGRES_PASSWORD=
# A Postgres server of your own instead of the db service, as the owner of tiko's database; the
# roles it needs are on the Database page of the guide. Empty: the db service.
DATABASE_URL=
# Password of the first account, admin. Empty: generated on first start, printed once to the log,
# saved to data/password. Not read once the account exists.
TIKO_PASSWORD=
# Encrypts each person's Jira token at rest. Needed only to connect Jira; demo tasks work without it.
# Generate one: openssl rand -base64 32. Changing it means everyone enters their token again.
TIKO_SECRET_KEY=
# The tracker for everyone, set at deploy time: demo or jira, and the Jira URL. Empty: an admin
# picks them in Settings → Task source. Set, they are shown there read-only.
TIKO_TRACKER=
JIRA_BASE_URL=
# A public demo: anyone starts in one click without an account, on the demo tasks, and is deleted
# after 7 days away unless they sign up. Do not publish the API port of a demo, only the web one.
TIKO_DEMO=
# Demo visitors the instance keeps at once. Empty: 500. Size it to the host.
TIKO_DEMO_LIMIT=
# Boards a person may own, admins aside. Empty: no limit. A demo visitor always holds 3.
TIKO_BOARD_LIMIT=
# Optional read-only GitHub token for public issues. Without it GitHub allows 60 requests an hour
# and GitHub cards update every few minutes; with it they update at the board's pace. Create a
# token with no access to private repositories: it is shared by everyone on this tiko.
GITHUB_TOKEN=
# Lets Prometheus read /metrics on the API port with `Authorization: Bearer <token>`. Empty: only
# a signed-in admin reads them. Generate: openssl rand -hex 24
TIKO_METRICS_TOKEN=
# A second port for /metrics, served apart from everything else, so Prometheus still gets its
# numbers when the instance is overloaded. Needs the token above. Empty: none. Example: 9464
TIKO_METRICS_PORT=
# API processes, one core each. A board is always served by the same one. With several, each
# has its own metrics port, counted up from TIKO_METRICS_PORT. Empty: 1
TIKO_WORKERS=
# A directory both containers share: the web container then reaches the API over Unix sockets
# in it instead of the network. Needs a volume mounted in both, see Configuration in the guide.
# Empty: the network.
TIKO_SOCKET_DIR=
# Proxies in front of tiko that are believed about the client's address, comma-separated
# networks, and the header they put it in. See "Behind a proxy" in Configuration in the guide.
# Empty: private networks and X-Forwarded-For.
TIKO_TRUSTED_PROXIES=
TIKO_CLIENT_IP_HEADER=
# TLS to Jira: set a CA bundle path for a corporate CA, or false to skip verification.
JIRA_TLS_VERIFY=true
JIRA_CA_BUNDLE=
# Ask GitHub every 30 minutes for new releases and show "update available" in About.
UPDATE_CHECK=true
# Daily usage counts without personal data (guide: Usage stats). false: off, and locks the
# switch in Settings → Privacy. Empty: on, an admin decides there.
TIKO_USAGE_STATS=
# Your own usage stats collector instead of ours. Empty: https://t.tiko.run/v1/events.
TIKO_STATS_URL=
# Error reports to Sentry, off unless true here or turned on in Settings → Privacy.
TIKO_ERROR_REPORTS=
# Your own Sentry DSN for error reports instead of ours.
TIKO_ERROR_REPORTS_DSN=
# Host ports of `docker compose up`, to run a second copy next to the first.
TIKO_PORT=3000
TIKO_API_PORT=8000

  "info": {
    "title": "tiko API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/boards": {
      "get": {
        "description": "Every board the key reaches, newest change first.",
        "operationId": "list_boards_boards_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoardList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Boards",
        "tags": [
          "boards"
        ]
      }
    },
    "/boards/{board_id}": {
      "get": {
        "description": "An outline of the board, or its elements a page at a time: all of them, or one frame's.",
        "operationId": "read_board_boards__board_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "board_id",
            "required": true,
            "schema": {
              "title": "Board Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "frame",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Frame"
            }
          },
          {
            "in": "query",
            "name": "elements",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "const": "all",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Elements"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/BoardOutline"
                    },
                    {
                      "$ref": "#/components/schemas/BoardPage"
                    }
                  ],
                  "title": "Response Read Board Boards  Board Id  Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Board",
        "tags": [
          "boards"
        ]
      }
    },
    "/me": {
      "get": {
        "description": "Who the key signs in, where, and what it may do.",
        "operationId": "get_me_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {

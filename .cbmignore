site/

# Brand asset generation, one-off Python
brand/

# Spec-kit scaffolding: shell templates, not application code
.specify/
specs/
.agents/

# Installer scripts (PowerShell), not part of the app
install/

# Local agent/tool state
.claude/
.playwright-mcp/
.ruff_cache/

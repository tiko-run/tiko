---
import Default from '@astrojs/starlight/components/Sidebar.astro'
import Topics from 'starlight-sidebar-topics/components/Sidebar.astro'
---

<!-- The tabs live in the header; on narrow screens the header has no room, so they come back here. -->
<div class="tiko-topics-mobile">
  <Topics />
  <a class="tiko-demo-mobile" href="https://demo.tiko.run">Try the demo</a>
</div>
<Default><slot /></Default>

<script>
  // Section titles (Features, Modules) are headings, not toggles; only groups nested under them fold.
  const TOP = '.sidebar-content .top-level > li > details'
  const pin = () =>
    document.querySelectorAll<HTMLDetailsElement>(TOP).forEach((group) => {
      group.open = true
      group.querySelector('summary')?.setAttribute('tabindex', '-1')
    })
  document.addEventListener('astro:page-load', pin)
  document.addEventListener('click', (event) => {
    if ((event.target as Element).closest?.(`${TOP} > summary`)) event.preventDefault()
  })
</script>

<style>
  .tiko-demo-mobile {
    display: block;
    margin-bottom: 1.5rem;
    padding: 0.5rem;
    border-radius: var(--tiko-radius);
    background: var(--sl-color-accent);
    color: var(--tiko-on-accent);
    font-weight: 500;
    text-align: center;
    text-decoration: none;
  }
  @media (min-width: 50rem) {
    .tiko-demo-mobile {
      display: none;
    }
  }
  @media (min-width: 64rem) {
    .tiko-topics-mobile {
      display: none;
    }
  }
</style>

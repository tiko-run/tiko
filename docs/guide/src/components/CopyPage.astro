---
import { Icon } from '@astrojs/starlight/components'

interface Props {
  /** The page's Markdown twin, which is what gets copied. */
  markdown: string
}

const { markdown } = Astro.props
const site = Astro.site ?? Astro.url
const source = new URL(markdown, site).href
const prompt = encodeURIComponent(`Read ${source} so I can ask questions about it.`)
---

<div class="tiko-copy not-content" data-markdown={markdown}>
  <button type="button" class="tiko-copy-main" data-copy>
    <Icon name="document" size="0.95rem" />
    <span data-label>Copy page</span>
  </button>
  <details class="tiko-copy-more">
    <summary aria-label="More ways to use this page"><Icon name="down-caret" size="0.95rem" /></summary>
    <div class="tiko-copy-menu" role="menu">
      <button type="button" role="menuitem" data-copy>
        <Icon name="document" size="1rem" />
        <span><strong>Copy page</strong>Copy this page as Markdown for LLMs</span>
      </button>
      <a role="menuitem" href={markdown} target="_blank" rel="noopener">
        <Icon name="notes" size="1rem" />
        <span><strong>View as Markdown</strong>Open this page as plain text</span>
      </a>
      <a role="menuitem" href={`https://chatgpt.com/?hints=search&q=${prompt}`} target="_blank" rel="noopener">
        <Icon name="external" size="1rem" />
        <span><strong>Open in ChatGPT</strong>Ask questions about this page</span>
      </a>
      <a role="menuitem" href={`https://claude.ai/new?q=${prompt}`} target="_blank" rel="noopener">
        <Icon name="external" size="1rem" />
        <span><strong>Open in Claude</strong>Ask questions about this page</span>
      </a>
    </div>
  </details>
</div>

<script>
  async function copy(box: HTMLElement) {
    const text = await fetch(box.dataset.markdown!).then((response) => response.text())
    await navigator.clipboard.writeText(text)
    const label = box.querySelector<HTMLElement>('[data-label]')!
    label.textContent = 'Copied'
    setTimeout(() => (label.textContent = 'Copy page'), 1500)
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element
    for (const menu of document.querySelectorAll<HTMLDetailsElement>('.tiko-copy-more[open]')) {
      if (!menu.contains(target) || target.closest('[role="menuitem"]')) menu.open = false
    }
    const button = target.closest('[data-copy]')
    if (button) copy(button.closest<HTMLElement>('.tiko-copy')!).catch(() => {})
  })
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return
    document.querySelectorAll<HTMLDetailsElement>('.tiko-copy-more[open]').forEach((menu) => (menu.open = false))
  })
</script>

<style>
  .tiko-copy {
    position: relative;
    display: flex;
    flex-shrink: 0;
    height: 2rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--tiko-radius);
    background: var(--sl-color-bg);
    font-size: 0.8125rem;
  }
  .tiko-copy button,
  .tiko-copy summary {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    border: 0;
    background: none;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }
  .tiko-copy-main {
    padding: 0 0.625rem;
  }
  .tiko-copy summary {
    height: 100%;
    padding: 0 0.375rem;
    border-inline-start: 1px solid var(--sl-color-hairline);
    list-style: none;
  }
  .tiko-copy summary::-webkit-details-marker {
    display: none;
  }
  .tiko-copy-main:hover,
  .tiko-copy summary:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }
  .tiko-copy-menu {
    position: absolute;
    inset-inline-end: -1px;
    top: calc(100% + 0.375rem);
    z-index: 20;
    width: 17rem;
    padding: 0.25rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 8px;
    background: var(--sl-color-bg);
    box-shadow: var(--tiko-shadow);
  }
  .tiko-copy-menu > * {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    width: 100%;
    padding: 0.5rem 0.625rem;
    border-radius: 6px;
    text-align: start;
    text-decoration: none;
    color: var(--sl-color-gray-3);
  }
  .tiko-copy-menu > *:hover {
    background: var(--sl-color-gray-6);
  }
  .tiko-copy-menu :global(svg) {
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
  .tiko-copy-menu strong {
    display: block;
    font-weight: 500;
    color: var(--sl-color-white);
  }
  .tiko-copy-menu span {
    font-weight: 400;
    line-height: 1.4;
  }
</style>

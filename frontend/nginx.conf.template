# Live boards are WebSockets under /api/; every other request keeps a plain connection.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 3000;
    root /usr/share/nginx/html;

    # The API gets a new IP on every redeploy (Railway, Render); re-resolve instead of caching it at start.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # The client's address for the API: a proxy in front of tiko sits on a private network and
    # is believed about who it forwards for; a forwarded address sent from anywhere else is not.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.0/8;
    set_real_ip_from fc00::/7;
    set_real_ip_from ::1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location /api/ {
        # $api_port is the process of the board in the path, or any of them: api-workers.envsh.
        proxy_pass http://${API_HOST}:$api_port;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header X-Real-IP $remote_addr;
        # The platform edge ends TLS; the API needs the scheme to mark the session cookie Secure.
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # An open board is quiet for long stretches; the default 60 s would cut its socket.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Built files carry a hash of their content in the name, so they never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # A board opened by its public link: kept out of search engines, and the link, which is the
    # access itself, out of the Referer of anything the page loads or links to.
    location /p/ {
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag "noindex, nofollow";
        add_header Referrer-Policy "no-referrer";
        try_files /index.html =404;
    }

    # Prerendered pages live in <path>/index.html; unknown paths fall back to the SPA.
    location / {
        # Pages are checked on every load, so a tab opened after an upgrade gets the new app.
        add_header Cache-Control "no-cache";
        try_files $uri $uri/index.html /index.html;
    }
}
